{
  "source": "What LibTmux::Workspace.load and .parse do with the keys and forms of tmuxp's workspace syntax. The probes are parsed with base_directory /workspace; test/unit/workspace_tmuxp_test.rb checks every entry against the loader, so the record changes when the loader does.",
  "statuses": {"supported": "Accepted and means what tmuxp means.", "difference": "Accepted, with the recorded difference.", "refused": "Refused with the recorded message."},
  "entries": [
    {"id":"session-name","scope":"session","key":"session_name","form":"string","status":"supported","probe":["session_name: a","windows:","  - window_name: w","    panes: [{}]"]},
    {"id":"windows","scope":"session","key":"windows","form":"nonempty list of windows","status":"supported","probe":["session_name: a","windows:","  - window_name: w","    panes: [{}]"]},
    {"id":"session-start-directory-absolute","scope":"session","key":"start_directory","form":"absolute path","status":"supported","probe":["session_name: a","start_directory: /var/log","windows:","  - window_name: w","    panes: [{}]"]},
    {"id":"start-directory-relative","scope":"window","key":"start_directory","form":"relative path","status":"difference","probe":["session_name: a","start_directory: /var","windows:","  - window_name: w","    start_directory: log","    panes: [{}]"],"difference":"A relative path resolves against the workspace file's directory, not the parent's start_directory.","observed":{"path":["windows",0,"start_directory"],"value":"/workspace/log"}},
    {"id":"start-directory-tilde","scope":"session","key":"start_directory","form":"leading ~","status":"difference","probe":["session_name: a","start_directory: ~/x","windows:","  - window_name: w","    panes: [{}]"],"difference":"~ is not expanded: the loader reads no ambient environment, so it names a directory called ~ under the workspace file's directory. Use an absolute path, or ${HOME} with expand_environment.","observed":{"path":["start_directory"],"value":"/workspace/~/x"}},
    {"id":"variable-expansion-default","scope":"session","key":"${VAR}","form":"environment variable in a value","status":"difference","probe":["session_name: a","start_directory: ${HOME}/x","windows:","  - window_name: w","    panes: [{}]"],"difference":"Left as written. In a shell command the pane's shell expands it; elsewhere it is literal text.","observed":{"path":["start_directory"],"value":"/workspace/${HOME}/x"}},
    {"id":"variable-expansion-opt-in","scope":"session","key":"${VAR}","form":"environment variable in a value, with expand_environment","status":"difference","probe":["session_name: a","start_directory: ${HOME}/x","windows:","  - window_name: w","    panes: [{}]"],"options":{"expand_environment":true,"environment":{"HOME":"/home/u"}},"difference":"Expanded only from the mapping passed to the loader, never from the process environment.","observed":{"path":["start_directory"],"value":"/home/u/x"}},
    {"id":"environment-strings","scope":"session","key":"environment","form":"mapping of strings","status":"supported","probe":["session_name: a","environment:","  A: b","windows:","  - window_name: w","    panes: [{}]"]},
    {"id":"environment-other-values","scope":"session","key":"environment","form":"number or other non-string value","status":"refused","probe":["session_name: a","environment:","  A: 1","windows:","  - window_name: w","    panes: [{}]"],"message":"invalid workspace configuration at $.environment; expected UTF-8 text"},
