      "path": "examples/window_links.rb",
      "gem": "libtmux"
    },
    {
      "id": "cancel",
      "path": "examples/cancel.rb",
      "gem": "libtmux"
    },
    {
      "id": "async_cancel",
      "path": "examples/async_cancel.rb",
      "gem": "libtmux-async"
    },
    {
      "id": "control_overflow",
      "path": "examples/control_overflow.rb",
      "gem": "libtmux"
    },
    {
      "id": "failed_group",
      "path": "examples/failed_group.rb",
      "gem": "libtmux"
    },
    {
      "id": "mcp_protocol",
      "path": "examples/mcp_protocol.rb",
      "gem": "libtmux-mcp"
    },
    {
      "id": "workspace_apply",
      "path": "examples/workspace_apply.rb",
      "gem": "libtmux-workspace"
    },
    {
      "id": "api_server",
      "path": "examples/api/server.rb",
      "gem": "libtmux",
      "api": {
        "symbols": [
          "LibTmux::Server",
          "LibTmux::Server.new"
        ],
        "description": "Connect a Server client to an existing endpoint and close it without stopping the daemon. The outer Server.start block owns the private demonstration server.",
        "output": "connected sessions: 1\nsessions after client close: 1\n"
      }
    },
    {
      "id": "api_list_sessions",
      "path": "examples/api/list_sessions.rb",
      "gem": "libtmux",
      "api": {
        "symbols": [
          "LibTmux::Server#list_sessions"
        ],
        "description": "List live session handles from a server containing two sessions.",
        "output": "sessions: $0, $1\n"
      }
    },
    {
      "id": "api_list_windows",
      "path": "examples/api/list_windows.rb",
      "gem": "libtmux",
      "api": {
        "symbols": [
          "LibTmux::Server#list_windows",
          "LibTmux::Session#list_windows"
        ],
        "description": "List all server windows and the windows belonging to one session.",
        "output": "server windows: 3\nwork windows: 2\n"
      }
    },
    {
      "id": "api_list_panes",
      "path": "examples/api/list_panes.rb",
      "gem": "libtmux",
      "api": {
        "symbols": [
          "LibTmux::Server#list_panes",
          "LibTmux::Session#list_panes",
          "LibTmux::Window#list_panes"
        ],
        "description": "List panes across the server, within one session, and within one window.",
        "output": "server panes: 3\nwork panes: 2\nwindow panes: 2\n"
      }
    },
    {
      "id": "api_new_session",
      "path": "examples/api/new_session.rb",
      "gem": "libtmux",
      "api": {
        "symbols": [
          "LibTmux::Server.start",
          "LibTmux::Server#new_session"
        ],
        "description": "Start a private server and create a session. Request a creation receipt to read the session, window, and pane IDs returned by that creation command.",
        "output": "session: $0\nwindow: @0\npane: %0\n"
      }
    },
    {
      "id": "api_new_window",
      "path": "examples/api/new_window.rb",
      "gem": "libtmux",
      "api": {
        "symbols": [
          "LibTmux::Session#new_window"
        ],
        "description": "Create a named window in an existing session and read its name from a snapshot.",
        "output": "window: logs\nsession windows: 2\n"
      }
    },
    {
      "id": "api_query",
      "path": "examples/api/query.rb",
      "gem": "libtmux",
      "api": {
        "symbols": [
          "LibTmux::Server#snapshot",
          "LibTmux::Server#search_panes",
          "LibTmux::Selection#where",
          "LibTmux::Selection#one",
          "LibTmux::Selection#one_or_nil"
        ],
        "description": "Filter a captured snapshot, distinguish a missing session, and acquire a fresh pane selection. one raises unless exactly one record matches; one_or_nil returns nil only for zero matches.",
        "output": "matching session: work\nmissing session: true\nmatching pane: %0\n"
      }
    },
    {
      "id": "api_capture",
      "path": "examples/api/capture.rb",
      "gem": "libtmux",
      "api": {
        "symbols": [
          "LibTmux::Pane#send_text",
          "LibTmux::Pane#send_keys",
          "LibTmux::Pane#capture"
        ],
        "description": "Send a command to a shell, poll the pane until its output line appears, then capture it. Match a whole output line so the echoed command cannot satisfy the check.",
        "output": "libtmux capture ready\n"
      }
    },
    {
      "id": "api_options",
      "path": "examples/api/options.rb",
      "gem": "libtmux",
      "api": {
        "symbols": [
          "LibTmux::Session#options",
          "LibTmux::Options#set",
          "LibTmux::Options#get",
          "LibTmux::OptionValue#as",
          "LibTmux::OptionValue#inherited?",
          "LibTmux::Session#hooks",
          "LibTmux::Hooks#set",
          "LibTmux::Hooks#get"
        ],
        "description": "Set and read a session option, convert its value to an Integer, and attach a hook command to the same session.",
        "output": "history-limit: 5000\ninherited: false\nhook: display-message created\n"
      }
    },
    {
      "id": "api_cancellation",
      "path": "examples/api/cancellation.rb",
      "gem": "libtmux",
      "api": {
        "symbols": [
          "LibTmux::Cancellation.new",
          "LibTmux::Cancellation#cancel",
          "LibTmux::Cancellation#close",
          "LibTmux::Server#run",
          "LibTmux::Server#wait_for"
        ],
        "description": "Wake a blocked request from another thread with a cancellation token and read the delivery evidence on the Cancelled error.",
        "output": "request: LibTmux::Cancelled\ndelivery: possibly_sent\n"
      }
    },
    {
      "id": "api_link_window",
      "path": "examples/api/link_window.rb",
      "gem": "libtmux",
      "api": {
        "symbols": [
          "LibTmux::Session#link_window",
          "LibTmux::Session#list_window_links"
        ],
        "description": "Link one window at two more indexes of its session and list the three links that share one window ID.",
        "output": "indexes: 0, 4, 9\nwindows: @0\n"
      }
    },
    {
      "id": "api_control",
      "path": "examples/api/control.rb",
      "gem": "libtmux",
      "api": {
        "symbols": [
          "LibTmux::Server#open_control",
          "LibTmux::ControlConnection#exchange",
          "LibTmux::ControlConnection#subscribe",
          "LibTmux::ControlSubscription#next"
        ],
        "description": "Open a control connection, run one command through it, and read the notification tmux sends when a window is renamed.",
        "output": "reply: ready\nevent: %window-renamed @0 renamed\n"
      }
    },
    {
      "id": "api_run_group",
      "path": "examples/api/run_group.rb",
      "gem": "libtmux",
      "api": {
        "symbols": [
          "LibTmux::Server#run_group"
        ],
        "description": "Submit an ordered group whose second command fails. The group reports unknown per-step outcomes, keeps the first command's effect and never runs the third.",
        "output": "success: false\nsteps: unknown, unknown, unknown\n@before: kept\n"
      }
    },
    {
      "id": "api_async_scope",
      "path": "examples/api/async_scope.rb",
      "gem": "libtmux-async",
      "api": {
        "symbols": [
          "LibTmux::Async.open",
          "LibTmux::Async::Scope#map"
        ],
        "description": "Open an Async scope over an existing server and capture every pane concurrently, in input order.",
        "output": "captured panes: 2\nall succeeded: true\n"
      }
    },
    {
      "id": "api_async_run",
      "path": "examples/api/async_run.rb",
      "gem": "libtmux-async",
      "api": {
        "symbols": [
          "LibTmux::Async::Server#run",
          "LibTmux::Async::Server#wait_for"
        ],
        "description": "Cancel an Async task whose tmux request is waiting and read the delivery evidence on the Cancelled error.",
        "output": "request: LibTmux::Cancelled\ndelivery: possibly_sent\n"
      }
    },
    {
      "id": "api_async_control",
      "path": "examples/api/async_control.rb",
      "gem": "libtmux-async",
      "api": {
        "symbols": [
          "LibTmux::Async::Server#open_control",
          "LibTmux::Async::ControlConnection#events",
          "LibTmux::Async::ControlSubscription#next"
        ],
        "description": "Open a control connection inside an Async scope and read the notification tmux sends when a window is renamed.",
        "output": "reply: ready\nevent: %window-renamed @0 renamed\n"
      }
    },
    {
      "id": "api_workspace_apply",
      "path": "examples/api/workspace_apply.rb",
      "gem": "libtmux-workspace",
      "api": {
        "symbols": [
          "LibTmux::Workspace.load",
          "LibTmux::Workspace#plan",
          "LibTmux::Workspace::Plan#steps",
          "LibTmux::Workspace::Plan#apply"
        ],
        "description": "Load the example workspace file, plan it against a snapshot, and apply the plan to an empty server.",
        "output": "planned steps: 11\napplied: true\nsessions: work\n"
      }
    },
    {
      "id": "api_workspace_failure",
      "path": "examples/api/workspace_failure.rb",
      "gem": "libtmux-workspace",
      "api": {
        "symbols": [
          "LibTmux::Workspace.parse",
          "LibTmux::Workspace::ApplyError#result",
          "LibTmux::Workspace::ApplyResult#created_refs",
          "LibTmux::Workspace::ApplyResult#compensation",
          "LibTmux::Workspace::ApplyResult#failed_action"
        ],
        "description": "Apply a workspace whose panes cannot fit with compensate: true. The failed split is reported, the created session is removed, and the borrowed session stays.",
        "output": "failed action: split_pane\ncreated a session: true\ncompensation: completed\nsessions: borrowed\n"
      }
    }
  ],
  "support": [
    "examples/support.rb",
    "examples/workspace.yaml",
    "examples/mcp_client.json"
