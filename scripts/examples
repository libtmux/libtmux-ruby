#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "pathname"

# Maintainer tool: one manifest owns executable discovery and source excerpts.
class ExampleManifest
  Error = Class.new(StandardError)
  PACKAGES = %w[libtmux libtmux-async libtmux-mcp libtmux-workspace].freeze
  API_KEYS = %w[description output symbols].freeze
  # Methods that pass the caller's own command line or layout on to tmux. Written
  # out, since an earlier release's library has no channel constants.
  CONDITIONAL_APIS = %w[
    LibTmux::Server#run LibTmux::Server#run_group LibTmux::Async::Server#run LibTmux::Async::Server#run_group
    LibTmux::ControlConnection#exchange LibTmux::Async::ControlConnection#exchange LibTmux::Window#select_layout
  ].freeze
  MARKER = /<!-- example: ([a-z0-9_\/-]+) -->\n(.*?)<!-- \/example -->/m
  attr_reader :root, :data

  # The library's capability registry and release order, loaded when a version 2
  # manifest is checked. A docs rebuild of an earlier release has already loaded
  # that release's library, which may have neither.
  def self.registry
    unless defined?(LibTmux::Internal::Capabilities)
      $LOAD_PATH.unshift(File.expand_path("../gems/libtmux/lib", __dir__))
      require "libtmux/tmux_version"
    end
    LibTmux::Internal::Capabilities
  end

  def self.releases
    registry
    LibTmux::Internal::TmuxVersion
  end

  def initialize(root)
    @root = File.expand_path(root)
    @data = JSON.parse(File.read(File.join(root, "examples/manifest.json")))
  end

  def check(write: false)
    raise Error, "unsupported example manifest" unless [1, 2].include?(data.fetch("version"))
    programs = data.fetch("programs")
    duplicates!(programs.map { |entry| entry.fetch("id") }, "program IDs")
    api_targets = []
    programs.each do |entry|
      raise Error, "unknown package for example: #{entry.fetch('id')}" unless PACKAGES.include?(entry.fetch("gem"))
      unless /\A[a-z][a-z0-9_]*\z/.match?(entry.fetch("id")) && /\Aexamples\/.+\.rb\z/.match?(entry.fetch("path"))
        raise Error, "invalid executable example entry"
      end
      next unless entry.key?("api")
      api = entry.fetch("api")
      unless api.is_a?(Hash) && [API_KEYS, (API_KEYS + ["capabilities"]).sort].include?(api.keys.sort) &&
          api["symbols"].is_a?(Array) && !api["symbols"].empty? &&
          api["symbols"].all? { |id| id.is_a?(String) && !id.empty? && !id.match?(/\s/) } &&
          api["description"].is_a?(String) && !api["description"].strip.empty? &&
          api["output"].is_a?(String) && !api["output"].strip.empty? && api["output"].end_with?("\n")
        raise Error, "invalid API example metadata: #{entry.fetch('id')}"
      end
      check_capabilities(entry.fetch("id"), api)
      api_targets.concat(api.fetch("symbols"))
    end
    duplicates!(api_targets, "API targets")
    declared = programs.map { |entry| entry.fetch("path") } + data.fetch("support")
    duplicates!(declared, "example paths")
    discovered = Dir.glob("examples/**/*", base: root).select { |path| File.file?(File.join(root, path)) } - ["examples/manifest.json"]
    raise Error, "unlisted example files: #{(discovered - declared).join(', ')}" unless (discovered - declared).empty?
    raise Error, "missing example files: #{(declared - discovered).join(', ')}" unless (declared - discovered).empty?
    declared.each { |path| safe_path(path) }
    snippets = data.fetch("snippets")
    duplicates!(snippets.map { |entry| entry.fetch("id") }, "snippet IDs")
    expected = snippets.to_h do |entry|
      raise Error, "snippet source is not a declared example" unless declared.include?(entry.fetch("source"))
      source = File.read(safe_path(entry.fetch("source")))
      if entry["region"]
        region = Regexp.escape(entry.fetch("region"))
        matches = source.scan(/^\s*# docs:begin #{region}\n(.*?)^\s*# docs:end #{region}\n/m)
        raise Error, "snippet requires exactly one source region: #{entry.fetch('id')}" unless matches.length == 1
        source = matches.first.first
        indentation = source.lines.reject { |line| line.strip.empty? }.map { |line| line[/\A */].size }.min || 0
        source = source.lines.map { |line| line.sub(/\A {0,#{indentation}}/, "") }.join
      end
      [entry.fetch("id"), "```#{entry.fetch('language')}\n#{source.chomp}\n```\n"]
    end
    documents = Dir.glob(["README.md", "CHANGELOG.md", "gems/*/README.md", "gems/*/CHANGELOG.md", "docs/**/*.md"], base: root)
      .reject { |path| path.start_with?("docs/_build/") }.sort
    unless documents == data.fetch("documents").sort
      raise Error, "document discovery differs from manifest"
    end
    used = []
    documents.each do |path|
      content = File.read(safe_path(path))
      rendered = content.gsub(MARKER) do
        id, original = Regexp.last_match(1), Regexp.last_match(2)
        replacement = expected.fetch(id) { raise Error, "unknown documented snippet: #{id}" }
        used << id
        raise Error, "excerpt differs from source: #{path} #{id}" unless write || original == replacement
        "<!-- example: #{id} -->\n#{replacement}<!-- /example -->"
      end
      remainder = rendered.gsub(MARKER, "")
      if remainder.match?(/^```(?:ruby|yaml|json)\s*$/)
        raise Error, "unregistered source excerpt: #{path}"
      end
      File.write(safe_path(path), rendered) if write && content != rendered
    end
    raise Error, "undocumented snippets: #{(expected.keys - used).join(', ')}" unless (expected.keys - used).empty?
    true
  rescue KeyError, JSON::ParserError => error
    raise Error, "malformed example manifest (#{error.class})"
  end

  # The tmux release a page for +entry+ states: the highest release at which
  # one of its declared capabilities opens, never below the port's floor.
  # Ranking uses the library's own release order, so 3.6a < 3.7 < 3.10.
  def tmux_release(entry)
    opens = entry.dig("api", "capabilities").to_a.map { |id| self.class.registry.capability(id).since }
    releases = self.class.releases
    ([releases::MINIMUM] + opens).max_by { |text| releases.parse(text) }
  end

  private

  # From manifest version 2, an API example lists the capabilities it needs. A
  # documented symbol refused on every call below a capability's release makes
  # that capability required; any known capability may be listed.
  def check_capabilities(id, api)
    declared = api.fetch("capabilities", [])
    if api.key?("capabilities")
      raise Error, "API example capabilities need manifest version 2: #{id}" unless data.fetch("version") == 2
      unless declared.is_a?(Array) && !declared.empty? && declared.all? { |name| name.is_a?(String) } &&
          declared.uniq.length == declared.length
        raise Error, "invalid API example capabilities: #{id}"
      end
    end
    return if data.fetch("version") == 1

    registry = self.class.registry::CAPABILITIES
    unknown = declared - registry.map(&:id)
    raise Error, "unknown capability in API example #{id}: #{unknown.join(', ')}" unless unknown.empty?
    symbols = api.fetch("symbols")
    required = registry.select { |entry| ((entry.apis - CONDITIONAL_APIS) & symbols).any? }.map(&:id)
    missing = required - declared
    raise Error, "API example #{id} uses a capability it does not declare: #{missing.join(', ')}" unless missing.empty?
  end

  def safe_path(path)
    raise Error, "invalid manifest path" unless path.is_a?(String) && !Pathname.new(path).absolute?
    full = File.expand_path(path, root)
    raise Error, "manifest path escapes repository" unless full.start_with?(root + File::SEPARATOR)
    full
  end

  def duplicates!(values, label)
    raise Error, "duplicate #{label}" unless values.uniq.length == values.length
  end
end

if $PROGRAM_NAME == __FILE__
  abort "usage: scripts/examples [--check|--write]" unless ARGV.empty? || [%w[--check], %w[--write]].include?(ARGV)
  begin
    manifest = ExampleManifest.new(File.expand_path("..", __dir__))
    manifest.check(write: ARGV == ["--write"])
    puts "Examples: #{manifest.data.fetch('programs').length} programs; source excerpts current"
  rescue ExampleManifest::Error => error
    abort error.message
  end
end
