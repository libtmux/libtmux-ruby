#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"
require "open3"
require "optparse"

# Repeats the real-tmux integration suite and counts each test's failures.
root = File.expand_path("..", __dir__)
Dir.chdir(root)
repeat = 10
output = "build/stress"
OptionParser.new do |parser|
  parser.on("--repeat N", Integer, "suite repetitions") { |value| repeat = value }
  parser.on("--output DIR", "directory for the CSV and Markdown table") { |value| output = value }
end.parse!
abort "--repeat must be positive" unless repeat.positive?

FileUtils.mkdir_p(output)
files = Dir["test/integration/**/*_test.rb"].sort
counts = Hash.new { |hash, name| hash[name] = {"runs" => 0, "failures" => 0} }
failed_runs = 0
repeat.times do |index|
  out, status = Open3.capture2e(Gem.ruby, "-Itest", "-e", "ARGV.shift(#{files.length}).each { |file| require File.expand_path(file) }",
    *files, "--verbose", "--seed", (index + 1).to_s)
  File.write(File.join(output, "run-#{index + 1}.log"), out)
  seen = 0
  out.each_line do |line|
    next unless (match = line.match(/\A(\S+#\S+) = [\d.]+ s = ([.FES])\s*\z/))

    seen += 1
    counts[match[1]]["runs"] += 1
    counts[match[1]]["failures"] += 1 if %w[F E].include?(match[2])
  end
  abort "run #{index + 1} reported no tests" if seen.zero?
  failed_runs += 1 unless status.success?
  warn "run #{index + 1}/#{repeat}: #{status.success? ? "passed" : "failed"}"
end

rows = counts.sort_by { |name, tally| [-tally["failures"], name] }
File.write(File.join(output, "failures.csv"),
  (["test,runs,failures"] + rows.map { |name, tally| "#{name},#{tally["runs"]},#{tally["failures"]}" }).join("\n") + "\n")
failing = rows.select { |_, tally| tally["failures"].positive? }
table = +"### Stress run: #{repeat} repetitions, #{failed_runs} failed, #{rows.length} tests\n\n"
if failing.empty?
  table << "No test failed.\n"
else
  table << "| Test | Runs | Failures |\n| --- | ---: | ---: |\n"
  failing.each { |name, tally| table << "| `#{name}` | #{tally["runs"]} | #{tally["failures"]} |\n" }
end
File.write(File.join(output, "summary.md"), table)
puts table
exit(failed_runs.zero? ? 0 : 1)
