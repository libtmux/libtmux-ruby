#!/usr/bin/env ruby
# frozen_string_literal: true

require "rbconfig"
require_relative "../test/support/sandbox"

root = File.expand_path("..", __dir__)
Dir.chdir(root)

mode = ARGV.shift || "mid"
unless %w[unit mid integration packaging types outer].include?(mode)
  abort "usage: scripts/check [unit|mid|integration|packaging|types|outer] [test files]"
end
abort "test file arguments require unit mode" if mode != "unit" && !ARGV.empty?

run = lambda do |*command|
  system(*command) || exit($?.exitstatus || 1)
end

if %w[mid outer].include?(mode)
  # Every Ruby script under scripts/, found by extension or shebang so a new
  # one needs no entry here.
  scripts = Dir["scripts/**/*"].select do |path|
    File.file?(path) && (path.end_with?(".rb") || File.open(path, &:gets).to_s.start_with?("#!/usr/bin/env ruby"))
  end
  files = Dir["{gems,test,examples}/**/*.rb", "gems/*/*.gemspec"] + %w[Gemfile Rakefile] + scripts
  files.each { |file| RubyVM::InstructionSequence.compile_file(file) }
  puts "Syntax: #{files.length} files"
  run.call(Gem.ruby, "scripts/generate", "--check")
  run.call(Gem.ruby, "scripts/emit-capabilities", "--check")
  run.call(Gem.ruby, "scripts/examples/examples", "--check")
end

run.call(Gem.ruby, "scripts/types", "--check") if %w[mid types outer].include?(mode)
run.call(Gem.ruby, "scripts/export-docs/export-docs", "--check") if %w[types outer].include?(mode)

suites = case mode
when "unit", "mid" then ["unit"]
when "outer" then %w[unit integration packaging]
when "types" then []
else [mode]
end

# test/<suite>, plus the tests a script keeps beside it: scripts/<name>/tests
# belongs to the unit suite and scripts/<name>/tests/<suite> to that suite.
suite_files = lambda do |suite|
  nested = suite == "unit" ? "scripts/*/tests/*_test.rb" : "scripts/*/tests/#{suite}/**/*_test.rb"
  (Dir["test/#{suite}/**/*_test.rb"] + Dir[nested]).sort
end

suites.each do |suite|
  files = ARGV.empty? ? suite_files.call(suite) : ARGV
  abort "no #{suite} tests found" if files.empty?
  run.call(Gem.ruby, "-Itest", "-rsupport/sandbox", "-e", "ARGV.each { |file| require File.expand_path(file) }", *files)
end

if %w[types outer].include?(mode)
  paths = Dir["gems/*/sig"].sort.flat_map { |path| ["-I", path] }
  run.call(Gem.ruby, Gem.bin_path("rbs", "rbs"), *paths, "validate")
end

run.call(Gem.ruby, "scripts/docs/docs") if mode == "outer"
