# frozen_string_literal: true

require "json"
require "fileutils"
require_relative "../gems/libtmux/lib/libtmux/criteria"

abort "usage: ruby scripts/generate [--check]" unless ARGV.empty? || ARGV == ["--check"]

root = File.expand_path("..", __dir__)
catalog = LibTmux::Internal::Catalog
operators = LibTmux::FilterExpr.const_get(:OPERATORS, false)
max_nodes = LibTmux::FilterExpr.const_get(:MAX_NODES, false)
max_members = LibTmux::FilterExpr.const_get(:MAX_MEMBERS, false)
max_string_bytes = LibTmux::FilterExpr.const_get(:MAX_STRING_BYTES, false)
class_names = {session: "SessionSnapshot", window: "WindowSnapshot", pane: "PaneSnapshot",
               window_link: "WindowLinkSnapshot", client: "ClientSnapshot"}
types = {text: "String", integer: "Integer", boolean: "bool"}
json_types = {text: "string", integer: "integer", boolean: "boolean"}
definitions = {}
reference = ->(name) { {"$ref" => "#/$defs/#{name}"} }
signature = ["# Generated by scripts/generate; edit the catalog.", "module LibTmux"]
markdown = ["# Captured fields and relations", "", "Generated from the core catalog by `scripts/generate`.", "",
  "These readers use captured data and perform no tmux I/O. Missing capture",
  "coverage raises an error. Nullable values and unsupported fields are distinct.", "",
  "The empty-as-null column identifies tmux formats whose empty output denotes",
  "absence. Other text retains empty strings. The `raw` reader always preserves",
  "the captured bytes, including an empty absence marker.", "",
  "The version column is the selected capture baseline; it does not establish",
  "tested compatibility or the tmux release that introduced a field. Client",
  "captures describe attached clients; client names are selectors, not stable IDs.", ""]

catalog.kinds.each do |kind|
  schema = catalog.entity(kind)
  signature << "  class #{class_names.fetch(kind)} < CapturedRecord"
  markdown.concat(["## #{schema.wire_entity}", "",
    "| Ruby reader | Wire name | Value | Empty as null | Integer bounds | Operators | tmux format | Baseline |",
    "| --- | --- | --- | --- | --- | --- | --- | --- |"])
  properties = {
    "and" => {"type" => "array", "items" => reference.call(kind), "maxItems" => max_nodes},
    "or" => {"type" => "array", "items" => reference.call(kind), "maxItems" => max_nodes},
    "not" => reference.call(kind)
  }
  schema.fields.each_value do |field|
    type = types.fetch(field.type) + (field.nullable ? "?" : "")
    signature << "    def #{field.name}: () -> #{type}"
    signature << "    alias #{field.name}? #{field.name}" if field.type == :boolean
    bounds = field.type == :integer ? "#{field.min}..#{field.max}" : ""
    allowed = field.operators.map { |operator| "`#{operator}`" }.join(", ")
    markdown << "| `#{field.name}` | `#{field.wire_name}` | `#{type}` | #{field.empty_is_null ? 'yes' : 'no'} | #{bounds} | #{allowed} | `#{field.format}` | #{field.min_version} |"
    scalar = {"type" => json_types.fetch(field.type)}
    scalar["minimum"] = field.min if field.min
    scalar["maximum"] = field.max if field.max
    if field.type == :text
      scalar["maxLength"] = max_string_bytes
      scalar["x-maxUtf8Bytes"] = max_string_bytes
    end
    literal = field.nullable ? {"anyOf" => [scalar, {"type" => "null"}]} : scalar
    filter_name = "#{kind}.#{field.name}"
    operations = field.operators.to_h do |operator|
      operand = case operator
      when :equals then literal
      when :not then reference.call(filter_name)
      when :in then {"type" => "array", "maxItems" => max_members, "items" => literal}
      else scalar
      end
      [operators.fetch(operator), operand]
    end
    definitions[filter_name] = {"anyOf" => [literal,
      {"type" => "object", "minProperties" => 1, "additionalProperties" => false, "properties" => operations}]}
    properties[field.wire_name] = reference.call(filter_name)
  end
  markdown.concat(["", "| Ruby relation | Wire name | Captured result |", "| --- | --- | --- |"])
  schema.relations.each_value do |relation|
    target = class_names.fetch(relation.target)
    result = relation.cardinality == :many ? "Selection[#{target}]" : target + (relation.nullable ? "?" : "")
    signature << "    def #{relation.name}: () -> #{result}"
    markdown << "| `#{relation.name}` | `#{relation.wire_name}` | `#{result}` |"
    names = relation.cardinality == :many ? %i[some every none] : %i[is is_not]
    operand = reference.call(relation.target)
    operand = {"anyOf" => [operand, {"type" => "null"}]} if relation.nullable
    properties[relation.wire_name] = {"type" => "object", "minProperties" => 1,
      "additionalProperties" => false, "properties" => names.to_h { |name| [operators.fetch(name), operand] }}
  end
  signature.concat(["  end", ""])
  markdown << ""
  definitions[kind.to_s] = {"type" => "object", "additionalProperties" => false, "properties" => properties}
end
signature << "end"

envelopes = catalog.kinds.map do |kind|
  {"type" => "object", "required" => %w[profile version entity where], "additionalProperties" => false,
   "properties" => {"profile" => {"const" => LibTmux::FilterExpr::PROFILE},
     "version" => {"type" => "integer", "const" => LibTmux::FilterExpr::VERSION},
     "entity" => {"const" => catalog.entity(kind).wire_entity}, "where" => reference.call(kind)}}
end
wire_schema = {"$schema" => "https://json-schema.org/draft/2020-12/schema",
  "$id" => "urn:libtmux-ruby:where:1", "title" => "Ruby libtmux criteria version 1",
  "description" => "The Ruby decoder additionally enforces byte, depth and node limits, rejects duplicate keys and floating-point tokens for integer fields.",
  "oneOf" => envelopes, "$defs" => definitions}
outputs = {
  "gems/libtmux/sig/fields.rbs" => signature.join("\n") + "\n",
  "gems/libtmux/schema/where-v1.json" => JSON.pretty_generate(wire_schema) + "\n",
  "docs/reference/fields.md" => markdown.join("\n")
}
changed = outputs.filter_map do |relative, content|
  path = File.join(root, relative)
  next if File.file?(path) && File.binread(path) == content

  unless ARGV.include?("--check")
    FileUtils.mkdir_p(File.dirname(path))
    File.binwrite(path, content)
  end
  relative
end
if ARGV.include?("--check") && !changed.empty?
  abort "generated files differ: #{changed.join(', ')}; run ruby scripts/generate"
end
puts "Generated files: #{outputs.length} #{ARGV.include?('--check') ? 'checked' : 'written or current'}"
