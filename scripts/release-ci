#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "open3"

class ReleaseCI
  class Error < StandardError; end

  REPOSITORY = "libtmux/libtmux-ruby"
  WORKFLOW = ".github/workflows/compatibility.yml"
  ARTIFACT = "rubygems-release"
  PUBLISH_JOB = "Publish gems"
  PUBLISH_STEP = "Publish core, Async, MCP and workspace"
  PAGE = 100

  def initialize(client: method(:github), downloader: method(:download))
    @client = client
    @downloader = downloader
  end

  def check(commit)
    raise Error, "release requires a full commit SHA" unless /\A[0-9a-f]{40}\z/.match?(commit)

    runs = @client.call("repos/#{REPOSITORY}/actions/workflows/compatibility.yml/runs?head_sha=#{commit}&event=push&branch=master&status=success&per_page=#{PAGE}")
    runs.fetch("workflow_runs").each do |run|
      next unless run.values_at("head_sha", "head_branch", "event", "path", "status", "conclusion") ==
        [commit, "master", "push", WORKFLOW, "completed", "success"]

      jobs = @client.call("repos/#{REPOSITORY}/actions/runs/#{run.fetch('id')}/jobs?filter=latest&per_page=#{PAGE}")
      next unless jobs.fetch("jobs").any? do |job|
        job["name"] == "All required cells" && job["conclusion"] == "success"
      end

      return run.fetch("id")
    end
    raise Error, "no successful master compatibility run for #{commit}; rerun Release after all required cells pass"
  end

  # A retry of a release run finds the artifact set the first attempt
  # retained and downloads it into the directory, so the retry validates and
  # publishes the same bytes. Answers true when it restored them and false when
  # the run has none and no publication can have started. Raises when a
  # retry finds the set missing after the publish step ran, because rebuilding
  # then could upload different bytes under a published version.
  def restore(repository:, run_id:, attempt:, directory:)
    artifacts = @client.call("repos/#{repository}/actions/runs/#{run_id}/artifacts?per_page=#{PAGE}").fetch("artifacts")
    if artifacts.any? { |artifact| artifact["name"] == ARTIFACT }
      @downloader.call(run_id, ARTIFACT, directory)
      return true
    end
    if attempt > 1 && publication_attempted?(repository, run_id)
      raise Error, "Release artifacts are missing after publication was attempted; recover the original files."
    end

    false
  end

  def self.run(arguments, environment = ENV, ci: new)
    case arguments
    in ["check", String => commit]
      puts "Compatibility run #{ci.check(commit)} passed for #{commit}"
    in ["restore", String => directory]
      restored = ci.restore(repository: environment.fetch("GITHUB_REPOSITORY"), run_id: environment.fetch("GITHUB_RUN_ID"),
        attempt: Integer(environment.fetch("GITHUB_RUN_ATTEMPT")), directory: directory)
      File.open(environment.fetch("GITHUB_OUTPUT"), "a") { |file| file.puts("retained=#{restored}") }
      puts restored ? "Restored #{ARTIFACT} into #{directory}" : "No retained #{ARTIFACT}; this run builds it"
    else
      warn "usage: scripts/release-ci check COMMIT | scripts/release-ci restore DIRECTORY"
      return 2
    end
    0
  rescue Error, KeyError, ArgumentError => error
    warn error.message
    1
  end

  private

  def publication_attempted?(repository, run_id)
    jobs(repository, run_id).any? do |job|
      job["name"] == PUBLISH_JOB && Array(job["steps"]).any? do |step|
        step["name"] == PUBLISH_STEP && step["conclusion"] != "skipped"
      end
    end
  end

  def jobs(repository, run_id)
    found = []
    (1..).each do |page|
      batch = @client.call("repos/#{repository}/actions/runs/#{run_id}/jobs?filter=all&per_page=#{PAGE}&page=#{page}").fetch("jobs")
      found.concat(batch)
      return found if batch.length < PAGE
    end
  end

  def github(path)
    output, status = Open3.capture2e("gh", "api", path)
    raise Error, "GitHub compatibility lookup failed: #{output}" unless status.success?

    JSON.parse(output)
  end

  def download(run_id, name, directory)
    output, status = Open3.capture2e("gh", "run", "download", run_id.to_s, "--name", name, "--dir", directory)
    raise Error, "downloading #{name} from run #{run_id} failed: #{output}" unless status.success?
  end
end

exit ReleaseCI.run(ARGV) if $PROGRAM_NAME == __FILE__
